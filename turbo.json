{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "out/**"],
      "env": [
        "RPC_URL",
        "NEYNAR_API_KEY",
        "ETHERSCAN_API_KEY",
        "STORAGE_POSTGRES_URL",
        "STORAGE_POSTGRES_PRISMA_URL",
        "STORAGE_SUPABASE_URL",
        "STORAGE_POSTGRES_URL_NON_POOLING",
        "STORAGE_SUPABASE_JWT_SECRET",
        "STORAGE_POSTGRES_USER",
        "STORAGE_POSTGRES_PASSWORD",
        "STORAGE_POSTGRES_DATABASE",
        "STORAGE_SUPABASE_SERVICE_ROLE_KEY",
        "STORAGE_POSTGRES_HOST",
        "STORAGE_SUPABASE_ANON_KEY",
        "GRAPH_STUDIO_API_KEY",
        "CRON_SECRET",
        "ADMIN_SECRET",
        "ADMIN_WALLET_ADDRESS",
        "ADMIN_FARCASTER_USERNAME",
        "ADMIN_FID",
        "ADDITIONAL_ADMIN_ADDRESSES",
        "MAINTENANCE_MODE",
        "BLOCKED_SELLER_ADDRESSES",
        "BLOB_READ_WRITE_TOKEN",
        "CLANKER_API_KEY",
        "TURBO_PRIVATE_KEY",
        "ARWEAVE_UPLOADER",
        "ARWEAVE_JWK",
        "CRYPTOART_MEDIA_ALLOW_MOCK_PAYMENT",
        "CRYPTOART_MEDIA_NETWORK",
        "CRYPTOART_MEDIA_ASSET",
        "CRYPTOART_MEDIA_PAY_TO",
        "CRYPTOART_MEDIA_MAX_FILE_SIZE",
        "CRYPTOART_MEDIA_TEMP_TTL_SECONDS",
        "CRYPTOART_OWNER_ADDRESS",
        "X402_FACILITATOR_URL",
        "CHAIN_84532_FACTORY_ADDRESS",
        "CHAIN_84532_ERC1155_FACTORY_ADDRESS",
        "CHAIN_84532_START_BLOCK",
        "CHAIN_84532_RPC_URL",
        "CHAIN_8453_FACTORY_ADDRESS",
        "CHAIN_8453_ERC1155_FACTORY_ADDRESS",
        "CHAIN_8453_START_BLOCK",
        "CHAIN_8453_RPC_URL",
        "CHAIN_1_FACTORY_ADDRESS",
        "CHAIN_1_ERC1155_FACTORY_ADDRESS",
        "CHAIN_1_START_BLOCK",
        "CHAIN_1_RPC_URL"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}

